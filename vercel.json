{
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/auth/tiktok/start", "destination": "/api/auth/tiktok/start" },
    { "source": "/auth/tiktok/callback", "destination": "/api/auth/tiktok/callback" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|png|jpg|jpeg|webp|avif|svg|woff2|wav))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
